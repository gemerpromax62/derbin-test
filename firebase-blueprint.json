{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Core user account profile for derbin client, storing non-PII settings, active subscription tier, and Liquid Glass UI theme preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name in the derbin launcher",
          "minLength": 1,
          "maxLength": 60
        },
        "minecraftNick": {
          "type": "string",
          "description": "Primary Minecraft account username linked to the dual-PC proxy",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "subscriptionPlan": {
          "type": "string",
          "description": "Active subscription tier",
          "enum": ["free", "30d", "90d", "lifetime"]
        },
        "licenseKey": {
          "type": "string",
          "description": "Activated derbin license key string",
          "minLength": 4,
          "maxLength": 64
        },
        "hwidStatus": {
          "type": "string",
          "description": "Current HWID binding status",
          "enum": ["bound", "unbound", "reset_ready"]
        },
        "glassPreset": {
          "type": "string",
          "description": "Selected iOS 26 Liquid Glass material preset",
          "enum": ["amber_gold", "emerald_liquid", "prismatic_ios26", "obsidian_frost"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": [
        "uid",
        "displayName",
        "minecraftNick",
        "subscriptionPlan",
        "licenseKey",
        "hwidStatus",
        "glassPreset",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection storing the user's private email address for license key delivery.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's private email address",
          "minLength": 3,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ProxyConfig": {
      "title": "ProxyConfig",
      "description": "Saved Dual-PC MITM proxy and DHCP network configuration preset belonging to a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Preset title (e.g. FunTime Stealth, ReallyWorld 0.1ms)",
          "minLength": 1,
          "maxLength": 50
        },
        "serverAddress": {
          "type": "string",
          "description": "Target Minecraft server domain or IP",
          "minLength": 3,
          "maxLength": 100
        },
        "accountName": {
          "type": "string",
          "description": "Minecraft nickname used for this preset",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "dhcpSubnet": {
          "type": "string",
          "description": "Local DHCP gateway IP address",
          "minLength": 7,
          "maxLength": 20
        },
        "pingSpoofMs": {
          "type": "number",
          "description": "Target artificial ping delay in milliseconds (0-120)"
        },
        "jitterSmoothPct": {
          "type": "number",
          "description": "Jitter smoothing percentage (10-100)"
        },
        "tracerouteBypass": {
          "type": "boolean",
          "description": "Whether ICMP traceroute hop masking is enabled"
        },
        "routerMode": {
          "type": "boolean",
          "description": "Whether hardware router emulation mode is enabled"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when preset was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when preset was updated"
        }
      },
      "required": [
        "uid",
        "name",
        "serverAddress",
        "accountName",
        "dhcpSubnet",
        "pingSpoofMs",
        "jitterSmoothPct",
        "tracerouteBypass",
        "routerMode",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores core non-PII user profile and active derbin client settings."
    },
    "/users/{userId}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Isolated PII storage for the user's private email address."
    },
    "/users/{userId}/configs/{configId}": {
      "schema": {
        "$ref": "#/entities/ProxyConfig"
      },
      "description": "Stores cloud-synced Dual-PC proxy and DHCP presets owned by the user."
    }
  }
}
